<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resume</title>

    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:Arial, Helvetica, sans-serif;
        }

        body{
            background:#eef2f7;
            color:#333;
            line-height:1.6;
        }

        header{
            background:#0f4c81;
            color:white;
            text-align:center;
            padding:30px;
        }

        header h1{
            margin-bottom:10px;
        }

        nav{
            background:#16324f;
            text-align:center;
            padding:15px;
        }

        nav a{
            color:white;
            text-decoration:none;
            margin:0 20px;
            font-weight:bold;
            transition:0.3s;
        }

        nav a:hover{
            color:#ffd166;
        }

        main{
            width:90%;
            max-width:1000px;
            margin:30px auto;
        }

        section,
        aside{
            background:white;
            padding:25px;
            margin-bottom:25px;
            border-radius:12px;
            box-shadow:0 6px 15px rgba(0,0,0,0.1);
        }

        h2{
            color:#0f4c81;
            margin-bottom:15px;
            border-bottom:2px solid #0f4c81;
            padding-bottom:8px;
        }

        figure{
            text-align:center;
            margin-bottom:20px;
        }

        figure img{
            width:180px;
            height:180px;
            border-radius:50%;
            border:5px solid #0f4c81;
            object-fit:cover;
        }

        figcaption{
            margin-top:10px;
            font-weight:bold;
            color:#0f4c81;
        }

        article p{
            text-align:justify;
        }

        table{
            width:100%;
            border-collapse:collapse;
            margin-top:15px;
        }

        table th{
            background:#0f4c81;
            color:white;
            padding:12px;
        }

        table td{
            border:1px solid #ccc;
            padding:12px;
            text-align:center;
        }

        table tr:nth-child(even){
            background:#f5f5f5;
        }

        ul{
            margin-left:25px;
        }

        ul li{
            margin:10px 0;
        }

        address{
            font-style:normal;
        }

        footer{
            background:#16324f;
            color:white;
            text-align:center;
            padding:18px;
            margin-top:20px;
        }

        @media(max-width:768px){

            nav a{
                display:block;
                margin:10px 0;
            }

            figure img{
                width:150px;
                height:150px;
            }

            table{
                font-size:14px;
            }

        }

    </style>

</head>
