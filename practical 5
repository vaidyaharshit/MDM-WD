<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Food Menu</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100">

    <!-- Header -->
    <header class="bg-red-600 text-white text-center py-8">
        <h1 class="text-4xl font-bold">Spice Garden</h1>
        <p class="mt-2 text-red-100">
            Delicious food made with love
        </p>
    </header>


    <!-- Food Menu -->
    <section class="max-w-7xl mx-auto px-6 py-12">

        <div class="text-center mb-10">
            <h2 class="text-3xl font-bold text-gray-800">
                Our Popular Dishes
            </h2>

            <p class="text-gray-500 mt-2">
                Explore our customer's favorite dishes
            </p>
        </div>


        <!-- Grid Container -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">

            <!-- Card 1 -->
            <div class="bg-white rounded-xl shadow-lg overflow-hidden
                        hover:shadow-2xl transition">

                <img
                    src="https://images.unsplash.com/photo-1565299624946-b28f40a0ae38"
                    alt="Pizza"
                    class="w-full h-56 object-cover">

                <div class="p-6">
                    <h3 class="text-xl font-bold text-gray-800">
                        Italian Pizza
                    </h3>

                    <p class="text-gray-500 mt-2">
                        Crispy crust topped with fresh vegetables,
                        mozzarella cheese and delicious herbs.
                    </p>

                    <button
                        class="mt-5 bg-red-600 text-white
                               px-5 py-2 rounded-lg
                               hover:bg-red-700 transition">
                        Order Now
                    </button>
                </div>
            </div>


            <!-- Card 2 -->
            <div class="bg-white rounded-xl shadow-lg overflow-hidden
                        hover:shadow-2xl transition">

                <img
                    src="https://images.unsplash.com/photo-1603133872878-684f208fb84b"
                    alt="Fried Rice"
                    class="w-full h-56 object-cover">

                <div class="p-6">
                    <h3 class="text-xl font-bold text-gray-800">
                        Special Fried Rice
                    </h3>

                    <p class="text-gray-500 mt-2">
                        Flavorful rice cooked with fresh vegetables,
                        spices and our special house sauce.
                    </p>

                    <button
                        class="mt-5 bg-red-600 text-white
                               px-5 py-2 rounded-lg
                               hover:bg-red-700 transition">
                        Order Now
                    </button>
                </div>
            </div>


            <!-- Card 3 -->
            <div class="bg-white rounded-xl shadow-lg overflow-hidden
                        hover:shadow-2xl transition">

                <img
                    src="https://images.unsplash.com/photo-1550547660-d9450f859349"
                    alt="Burger"
                    class="w-full h-56 object-cover">

                <div class="p-6">
                    <h3 class="text-xl font-bold text-gray-800">
                        Classic Burger
                    </h3>

                    <p class="text-gray-500 mt-2">
                        Juicy patty with fresh lettuce, tomato,
                        cheese and our signature sauce.
                    </p>

                    <button
                        class="mt-5 bg-red-600 text-white
                               px-5 py-2 rounded-lg
                               hover:bg-red-700 transition">
                        Order Now
                    </button>
                </div>
            </div>


            <!-- Card 4 -->
            <div class="bg-white rounded-xl shadow-lg overflow-hidden
                        hover:shadow-2xl transition">

                <img
                    src="https://images.unsplash.com/photo-1563379091339-03246963d96c"
                    alt="Pasta"
                    class="w-full h-56 object-cover">

                <div class="p-6">
                    <h3 class="text-xl font-bold text-gray-800">
                        Creamy Pasta
                    </h3>

                    <p class="text-gray-500 mt-2">
                        Soft pasta tossed in creamy sauce with
                        herbs and fresh vegetables.
                    </p>

                    <button
                        class="mt-5 bg-red-600 text-white
                               px-5 py-2 rounded-lg
                               hover:bg-red-700 transition">
                        Order Now
                    </button>
                </div>
            </div>


            <!-- Card 5 -->
            <div class="bg-white rounded-xl shadow-lg overflow-hidden
                        hover:shadow-2xl transition">

                <img
                    src="https://images.unsplash.com/photo-1601050690597-df0568f70950"
                    alt="Samosa"
                    class="w-full h-56 object-cover">

                <div class="p-6">
                    <h3 class="text-xl font-bold text-gray-800">
                        Crispy Samosa
                    </h3>

                    <p class="text-gray-500 mt-2">
                        Golden crispy pastry filled with spicy
                        potatoes and aromatic Indian spices.
                    </p>

                    <button
                        class="mt-5 bg-red-600 text-white
                               px-5 py-2 rounded-lg
                               hover:bg-red-700 transition">
                        Order Now
                    </button>
                </div>
            </div>


            <!-- Card 6 -->
            <div class="bg-white rounded-xl shadow-lg overflow-hidden
                        hover:shadow-2xl transition">

                <img
                    src="https://images.unsplash.com/photo-1551024506-0bccd828d307"
                    alt="Dessert"
                    class="w-full h-56 object-cover">

                <div class="p-6">
                    <h3 class="text-xl font-bold text-gray-800">
                        Chocolate Dessert
                    </h3>

                    <p class="text-gray-500 mt-2">
                        Rich and delicious chocolate dessert,
                        perfect for ending your meal.
                    </p>

                    <button
                        class="mt-5 bg-red-600 text-white
                               px-5 py-2 rounded-lg
                               hover:bg-red-700 transition">
                        Order Now
                    </button>
                </div>
            </div>

        </div>
    </section>


    <!-- Footer -->
    <footer class="bg-gray-900 text-white text-center py-6">
        <p>© 2026 Spice Garden | All Rights Reserved</p>
    </footer>

</body>
</html>
